# Slack app (api.slack.com -> your app -> Socket Mode / OAuth & Permissions / Basic Information)
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Option A — plain app, no token rotation: just set the static bot token.
SLACK_BOT_TOKEN=xoxb-...

# Option B — app has token rotation enabled: leave SLACK_BOT_TOKEN unset and
# set these instead (Basic Information -> App Credentials for Client ID/Secret,
# OAuth & Permissions page for the initial refresh token). The bot fetches and
# auto-refreshes its own access token from these; SLACK_REFRESH_TOKEN only
# needs to be right the first run — after that it's persisted/rotated at
# SLACK_TOKEN_STORE_PATH.
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_REFRESH_TOKEN=xoxe-1-...
# SLACK_TOKEN_STORE_PATH=./data/slack_token.json

# DevRev (DevRev app -> Settings -> PATs)
DEVREV_API_TOKEN=...
DEVREV_API_BASE_URL=https://api.devrev.ai
# Field key on the DevRev work item that holds the linked Freshdesk ticket id.
# Confirmed for this org via `npm run devrev:inspect -- <TICKET-ID>`:
# custom_fields.ctype__fd_id. Re-verify if a different ticket type/subtype
# doesn't carry this field.
DEVREV_FRESHDESK_FIELD_KEY=ctype__fd_id

# Freshdesk
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=...

# Daily followup schedule (node-cron syntax, local server time). Default: 10am, Mon-Fri.
FOLLOWUP_CRON=0 10 * * 1-5

# SQLite file path
DB_PATH=./data/tracked_threads.db

# Optional — Claude reads the DevRev comments + Slack thread each daily cycle
# to judge who's actually blocking progress right now (falls back to the
# plain DevRev assignee if unset, or if it can't confidently tell).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
